# Copiá este archivo a .env y completá los valores. Nunca commitees .env real.
# Ver ENVIRONMENT.md para el detalle de cada variable.

# --- Base de datos (obligatoria) ---
DATABASE_URL="postgresql://tite:tite_dev_password@localhost:5432/tite_dev"

# --- Auth (obligatoria) ---
# Generá un secreto con: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# --- Google OAuth (opcional en dev; sin esto sólo funciona login con email) ---
# TODO: requires external credentials — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Storage de imágenes (opcional; sin esto usa disco local automáticamente) ---
# TODO: requires external credentials — completar sólo si vas a usar S3-compatible en vez de disco local.
# STORAGE_PROVIDER="s3"
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT=""

# --- AI / clasificación avanzada (opcional; sin esto usa el clasificador rule-based) ---
# TODO: requires external credentials — completar sólo si vas a enchufar un proveedor de vision/LLM real.
# AI_PROVIDER_API_KEY=""

# --- Clima ---
# Open-Meteo no requiere API key. No hace falta ninguna variable acá.

# --- Entorno ---
NODE_ENV="development"
